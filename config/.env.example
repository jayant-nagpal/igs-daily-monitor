# =============================================================================
# config/.env.example — IGS Daily Monitor configuration (VARIABLE NAMES ONLY)
# =============================================================================
# This file documents every environment variable the producer can read. It
# contains NO real values on purpose.
#
#   * Real connection values are provided SEPARATELY in a private credentials
#     document. Never paste them here and never commit them.
#   * Do NOT put any of these in VITE_* variables — those are bundled into the
#     browser build. The React app must never see a credential.
#   * Offline / sample mode needs none of these set.
#
# On Windows, set these for the current shell before running the producer, e.g.
#
#     set IGS_ENV=prod
#     set IGS_ALLOW_LIVE=1
#     set IGS_POSITIONSDB_URL=...
#
# (scripts\windows\run_once.bat sets the mode gates for you.)
# =============================================================================

# --- Mode / safety gates ------------------------------------------------------
# Explicit environment; live mode refuses to default. One of: prod|altprod|stage|dev
IGS_ENV=
# Master live switch. Must be 1 AND the producer must be called with --confirm-live.
IGS_ALLOW_LIVE=
# Email is independent and OFF by default. Leave BLANK for no-email runs.
IGS_ALLOW_EMAIL=
# Dashboard capture: 1 = emit the same numeric objects the dashboard renders.
IGS_DASHBOARD_CAPTURE=
# Absolute artifact output directory (required for live/intraday runs).
IGS_DASHBOARD_CAPTURE_DIR=

# --- SQL Server sources (mssql+pyodbc, "ODBC Driver 18 for SQL Server") -------
# Full SQLAlchemy URLs. Add Encrypt / TrustServerCertificate per your policy.
IGS_POSITIONSDB_URL=
IGS_WAREHOUSE_URL=
IGS_TIMESERIESDB_URL=
IGS_REFDB_URL=

# --- SignalStore PostgreSQL (postgresql+psycopg2) ----------------------------------
# Either one URL...
IGS_SIGNALSTORE_URL=
# ...or the split parts (used only if IGS_SIGNALSTORE_URL is unset):
IGS_SIGNALSTORE_HOST=
IGS_SIGNALSTORE_PORT=
IGS_SIGNALSTORE_USER=
IGS_SIGNALSTORE_PASSWORD=

# --- ExecAPI REST API (HTTP Basic auth) -------------------------------------------
IGS_EXECAPI_BASE_URL=
IGS_EXECAPI_USER=
IGS_EXECAPI_PASSWORD=

# --- RiskAPI REST API (HTTP Basic auth; may reuse ExecAPI creds) ----------------------
IGS_RISKAPI_BASE_URL=
IGS_RISKAPI_USER=
IGS_RISKAPI_PASSWORD=

# --- Intraday scheduler -------------------------------------------------------
IGS_MARKET_TZ=Asia/Kolkata
IGS_MARKET_OPEN=09:15
IGS_MARKET_CLOSE=15:35
IGS_INTRADAY_INTERVAL_MIN=30

# --- Publication --------------------------------------------------------------
# local | hosted
IGS_PUBLISH_MODE=local
# For hosted mode only (auth must NOT be a VITE_* var):
IGS_PUBLISH_ENDPOINT=
IGS_PUBLISH_AUTH_TOKEN=
